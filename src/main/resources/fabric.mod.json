{
    "schemaVersion": 1,
    "id": "death-coordinates-logger",
    "version": "${version}",
    "name": "Death Coordinates Logger",
    "description": "Prints your death coordinates and dimension in chat, saves them to a log file, marks each one with a red beacon beam you can click away, and lets you recall them with /lastdeath.",
    "authors": [
        "VerrySilly"
    ],
    "contact": {
        "sources": "https://github.com/VerrySilly/death-coordinates-logger"
    },
    "license": "CC0-1.0",
    "icon": "assets/death-coordinates-logger/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "com.verrysilly.deathcoords.DeathCoordinatesLogger"
        ],
        "client": [
            "com.verrysilly.deathcoords.client.DeathCoordinatesLoggerClient"
        ]
    },
    "depends": {
        "fabricloader": ">=0.18.2",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/yh9cz8Edwy"
            }
        }
    }
}